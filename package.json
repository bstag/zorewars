{
  "name": "zorewars",
  "version": "0.1.0",
  "description": "A browser-based programming game inspired by Core War: programs battle inside a simulated circular memory array.",
  "type": "module",
  "bin": {
    "zorewars": "cli/zorewars.js"
  },
  "scripts": {
    "start": "node cli/zorewars.js serve",
    "dev:cloudflare": "wrangler dev",
    "test": "node --test",
    "bench": "node scripts/benchmark.js",
    "compare": "node scripts/pmars-compare.js",
    "deploy": "wrangler deploy",
    "build:editor": "node scripts/build-editor.js",
    "build:three": "node scripts/build-three.js",
    "fuzz": "node scripts/plane-fuzz.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "three": "0.185.1",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "webgpu": "^0.6.2"
  }
}
