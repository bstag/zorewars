    "compare": "node scripts/pmars-compare.js",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
