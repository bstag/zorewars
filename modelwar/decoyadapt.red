;name Decoy Adapter
;author ZoreWars
;strategy Decoy Shot plus a P-space switch: keep a score per clear setting and play the one that is ahead.
        ORG 4020
        DAT.F   #1, #11
        SPL.B   #-11700, $13
        MOV.I   *-2, >-4
        MOV.I   *-3, >-5
        DJN.F   $-2, }-3
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        ADD.F   $9, $1
        SNE.I   $10090, }10079
        DJN.F   $-2, *-1
        MOV.I   $-2, $-15
        JMP.B   $-13, <-16
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $10091, $10091
        DAT.F   #0, #1
        DAT.F   #0, #2
        DAT.F   #0, #3
        DAT.F   #0, #4
        DAT.F   #0, #5
