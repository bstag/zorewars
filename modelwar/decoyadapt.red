;name Decoy Adapter
;author ZoreWars
;strategy Decoy Shot plus a P-space switch: keep a score per clear setting and play the one that is ahead.
        ORG 20
        DAT.F   #1, #11
        SPL.B   #8419, $13
        MOV.I   *-2, >-4
        MOV.I   *-3, >-5
        DJN.F   $-2, }-3
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        ADD.F   $9, $1
        SNE.I   $10090, }10079
        DJN.F   $-2, *-1
        MOV.I   $-2, $-15
        JMP.B   $-13, <-16
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $10091, $10091
        LDP.AB  #0, $31
        LDP.AB  #1, $31
        LDP.AB  #2, $31
        LDP.AB  #3, $31
        SLT.AB  #2, $27
        JMP.B   $2, $0
        JMP.B   $14, $0
        JMZ.B   $6, $24
        SNE.AB  #1, $23
        JMP.B   $2, $0
        JMP.B   $10, $0
        MOV.AB  #1, $24
        JMP.B   $2, $0
        MOV.AB  #-1, $22
        JMZ.B   $4, $18
        ADD.B   $20, $19
        STP.B   $18, #3
        JMP.B   $3, $0
        ADD.B   $17, $15
        STP.B   $14, #2
        MOV.AB  #0, $12
        MOV.B   $13, $15
        SUB.B   $11, $14
        ADD.AB  #1000, $13
        SLT.AB  #1000, $12
        JMP.B   $2, $0
        MOV.AB  #1, $6
        STP.B   $5, #1
        JMZ.B   $-38, $4
        MOV.A   #5000, $-48
        JMP.B   $-40, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
