;name Decoy Shot
;author ZoreWars
;strategy Oneshot scanner + d-clear, then a periodic decoy that only other scanners see.
        ORG 11
        DAT.F   #1, #11
        SPL.B   #8419, $13
        MOV.I   *-2, >-4
        MOV.I   *-3, >-5
        DJN.F   $-2, }-3
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        ADD.F   $9, $1
        SNE.I   $10090, }10079
        DJN.F   $-2, *-1
        MOV.I   $-2, $-15
        JMP.B   $-13, <-16
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $0, $0
        DAT.F   $10091, $10091
        DAT.F   #1, #11
        DAT.F   #2, #10
        DAT.F   #3, #9
        DAT.F   #4, #8
        DAT.F   #5, #7
        DAT.F   #6, #6
        DAT.F   #7, #5
        DAT.F   #8, #4
        DAT.F   #9, #3
        DAT.F   #10, #2
