        mov.b  scanptr,   tmp
        add.ab #11+52, tmp
        slt.ab #SPAN,     tmp
        jmp    oneshot
        mov    scanptr,   gate
        jmp    clear-1,   <gate
tmp     dat 0,0
        dat 0,0
        dat 0,0
        dat 0,0
inc     dat    1271,      1271
