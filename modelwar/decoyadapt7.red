bptr    dat    #1,        #11
dptr    spl    #7390,      13
clear   mov    *bptr,     >gate
        mov    *bptr,     >gate
        djn.f  clear,     }dptr
        dat 0,0
        dat 0,0
        dat 0,0
        dat 0,0
        dat 0,0
oneshot add    inc,       scanptr
scanptr sne.f  first+27, }first
